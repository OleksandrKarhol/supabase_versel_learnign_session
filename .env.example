# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase ---
# Project Settings -> API (in your Supabase project dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: same page, "service_role" secret.
# Server-side only — never expose this to the browser / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# --- App ---
# Used for building absolute links (e.g. invite links). Vercel sets its own
# equivalent in production/preview automatically; only needed for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
